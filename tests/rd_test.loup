@mode(host.dual)

# Unit tests for rd's decisions (commands/rd.loup): invalid names, resolving
# `.` and `..`, the current directory and its parents, the RdError (message
# and exit status) or action each kind of operand gets, and removing with /Q.
# The fixtures go under build/tmp/rd_unit; nothing here asks a question.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with `loup-bootstrap test --no-parallel` (Stage0, source/ on LOUPPATH), one
# test per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq, expectThrows);
from io.fs import (createDir, isDir, removeDir, writeText);
from appinfo import (EXIT_FAILURE, EXIT_FILE_NOT_FOUND, EXIT_PATH_NOT_FOUND, EXIT_ACCESS_DENIED,
    EXIT_IN_USE, EXIT_INVALID_NAME, EXIT_DIR_NOT_EMPTY);
from win.messages import (MSG_ACCESS_DENIED, MSG_DIR_NAME_INVALID, MSG_DIR_NOT_EMPTY,
    MSG_FILE_NOT_FOUND, MSG_INVALID_NAME, MSG_PATH_NOT_FOUND);
from commands.rd import (RdError, MSG_IN_USE, ACT_RMDIR, ACT_TREE, ACT_CONTENTS, has_invalid_chars,
    target_path, is_current_or_above, missing_error, check_operand, action_for, remove_operand);

const ROOT: string = "build/tmp/rd_unit";

func fresh(): void {
    if (isDir(ROOT)) {
        removeDir(ROOT);
    }
    createDir(ROOT + "/empty");
    createDir(ROOT + "/full/sub");
    writeText(ROOT + "/full/a.txt", "a\n");
    writeText(ROOT + "/file.txt", "f\n");
}

func same(a: string, b: string, what: string): void {
    expect(a == b, what + ": got '" + a + "', expected '" + b + "'");
}

func test_invalid_characters(): void {
    expect(!has_invalid_chars("old logs\\2024"), "plain");
    expect(has_invalid_chars("old*"), "star");
    expect(has_invalid_chars("a?"), "question mark");
    expect(has_invalid_chars("c:x"), "colon");
    expect(has_invalid_chars("a\nb"), "newline");
}

func test_target_path(): void {
    same(target_path("a\\b\\"), "a/b", "trailing separator");
    same(target_path("a\\..\\b"), "b", "dot-dot by name");
    same(target_path(".\\a\\."), "a", "dots");
    same(target_path("."), ".", "current directory");
    same(target_path("a\\.."), ".", "back to the current directory");
    same(target_path("..\\.."), "../..", "above");
    same(target_path("\\tmp\\..\\.."), "/", "root");
}

func test_current_or_above(): void {
    expect(is_current_or_above("."), ".");
    expect(is_current_or_above(".."), "..");
    expect(is_current_or_above("../.."), "../..");
    expect(!is_current_or_above("../x"), "a sibling");
    expect(!is_current_or_above("x"), "a subdirectory");
    expect(!is_current_or_above("/"), "the root is handled apart");
}

# The message and exit status check_operand() throws for an operand, or
# ("", 0) when rd may go ahead.
func failure(operand: string, recurse: bool): (string, int) {
    try {
        check_operand(operand, recurse);
    } catch (RdError as e) {
        return (e.message, e.code);
    }
    return ("", 0);
}

func check_failure(operand: string, recurse: bool, message: string, code: int, what: string): void {
    let (got, status) = failure(operand, recurse);
    same(got, message, what);
    expectEq(status, code, what + " (status)");
}

func test_operand_failures(): void {
    fresh();
    check_failure(ROOT + "/empty", false, "", 0, "empty directory");
    check_failure(ROOT + "\\full\\", false, MSG_DIR_NOT_EMPTY, EXIT_DIR_NOT_EMPTY, "not empty");
    check_failure(ROOT + "/full", true, "", 0, "/S accepts it");
    check_failure(ROOT + "/nope", true, MSG_FILE_NOT_FOUND, EXIT_FILE_NOT_FOUND, "missing");
    check_failure(ROOT + "/nope/x", true, MSG_PATH_NOT_FOUND, EXIT_PATH_NOT_FOUND, "missing parent");
    check_failure(ROOT + "/file.txt/x", true, MSG_PATH_NOT_FOUND, EXIT_PATH_NOT_FOUND, "file as parent");
    check_failure(ROOT + "/file.txt", true, MSG_DIR_NAME_INVALID, EXIT_FAILURE, "a file: 267 does not fit");
    check_failure(ROOT + "/f*", true, MSG_INVALID_NAME, EXIT_INVALID_NAME, "wildcard");
    check_failure("", false, MSG_INVALID_NAME, EXIT_INVALID_NAME, "empty operand");
    check_failure("/", true, MSG_ACCESS_DENIED, EXIT_ACCESS_DENIED, "the root");
    check_failure(".", false, MSG_IN_USE, EXIT_IN_USE, "current directory");
    check_failure(".", true, "", 0, "current directory with /S: contents first");
    check_failure("..", true, MSG_IN_USE, EXIT_IN_USE, "parent directory");
    same(missing_error(ROOT + "/nope").message, MSG_FILE_NOT_FOUND, "missing_error");
    expectThrows(func(): void { check_operand(ROOT + "/full", false); }, "throws for a full directory");
    removeDir(ROOT);
}

func test_remove_operand_reports_status(): void {
    fresh();
    let (none, ok) = remove_operand(ROOT + "/empty", ACT_RMDIR, false);
    expectEq(none.len(), 0, "an empty directory goes");
    expectEq(ok, 0, "status 0");
    expect(!isDir(ROOT + "/empty"), "removed");
    let (problems, status) = remove_operand(ROOT + "/full", ACT_TREE, false);
    expectEq(problems.len(), 0, "a tree goes with /S /Q");
    expectEq(status, 0, "status 0 for the tree");
    expect(!isDir(ROOT + "/full"), "tree removed");
    removeDir(ROOT);
}

func test_actions(): void {
    fresh();
    expectEq(action_for(ROOT + "/empty", false), ACT_RMDIR, "rmdir");
    expectEq(action_for(ROOT + "/full", true), ACT_TREE, "tree");
    expectEq(action_for(".", true), ACT_CONTENTS, "contents of the current directory");
    removeDir(ROOT);
}
