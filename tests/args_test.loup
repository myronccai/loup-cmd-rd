@mode(host.dual)

# Unit tests for rd's argument parsing (cli/args.loup): `/S` and `/Q` in any
# case and combined (`/s/q`), other `/X` tokens as directories, help, version
# and `--`.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with `loup-bootstrap test --no-parallel` (Stage0, source/ on LOUPPATH), one
# test per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, rd_switches);

func test_no_arguments(): void {
    let none: list[string] = [];
    let opts = parse_args(none).unwrap();
    expectEq(opts.operands.len(), 0, "no operands");
    expect(!opts.help and !opts.version and !opts.recurse and !opts.quiet, "nothing set");
}

func test_switches(): void {
    expectEq(rd_switches().len(), 2, "/S and /Q");
    let opts = parse_args(["/S", "old", "-q"]).unwrap();
    expect(opts.recurse and opts.quiet, "/S -q");
    expectEq(opts.operands.join(","), "old", "operand");
    expect(parse_args(["/s/q", "x"]).unwrap().quiet, "/s/q combined");
    expect(!parse_args(["/q", "x"]).unwrap().recurse, "/q alone");
}

func test_other_arguments_are_directories(): void {
    let opts = parse_args(["/tmp/x", "/p", "-x", "a\\b", "/S:x"]).unwrap();
    expectEq(opts.operands.join(","), "/tmp/x,/p,-x,a\\b,/S:x", "operands in order");
    expect(!opts.recurse, "/S:x is not /S");
}

func test_help(): void {
    expect(parse_args(["/?"]).unwrap().help, "/?");
    expect(parse_args(["/S", "old", "-?"]).unwrap().help, "-? with a directory");
    expect(parse_args(["--help"]).unwrap().help, "--help");
}

func test_version(): void {
    expect(parse_args(["--version"]).unwrap().version, "--version");
    expect(!parse_args(["a", "--version"]).unwrap().version, "--version with a directory");
}

func test_double_dash(): void {
    let opts = parse_args(["/Q", "--", "/S"]).unwrap();
    expect(opts.quiet and !opts.recurse, "/S after -- is a directory");
    expectEq(opts.operands[0], "/S", "operand");
}
