@mode(host.dual)

# Help and version text of rd: what `rd /?` prints (a short summary of this
# recreation's syntax and switches) and the series' `--version` line.
#
# Runtime: host.dual. Compiled into the native binary build/rd by
# `make build`; `make run` (Stage0's `loup-bootstrap run`) interprets the same
# code.

from appinfo import (APP_NAME, APP_VERSION);

# The text of `rd /?`: a short summary of this recreation's syntax and
# switches.
pub func usage(): string {
    let lines = [
        "Remove directories.",
        "",
        "RD [/S] [/Q] path [path ...]",
        "RMDIR is the same command.",
        "",
        "  path  A directory to remove. Without /S it must be empty.",
        "  /S    Remove the directory with everything in it. Symbolic links",
        "        inside it are removed, never followed.",
        "  /Q    With /S, do not ask \"Are you sure (Y/N)?\" first.",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}
