@mode(host.dual)

# Command-line parsing for rd, with the shared Windows switch parser
# (win/switches.loup): `/S` and `/Q`. A `/X` that is not one of rd's switches
# is a path.
#
# Runtime: host.dual. Compiled into the native binary build/rd by
# `make build`; `make run` (Stage0's `loup-bootstrap run`) interprets the same
# code.

from win.switches import (SwitchSpec, flag, parse_switches, has_switch, switch_error_message);

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub recurse: bool;      # /S
    pub quiet: bool;        # /Q
    pub operands: list[string];
}

pub func rd_switches(): list[SwitchSpec] {
    return [flag("S"), flag("Q")];
}

# The statement form of `match` (arms that return) is deliberate: a match
# expression whose arms build new values returns freed memory natively.
pub func parse_args(argv: list[string]): Result[Options, string] {
    let parsed = match parse_switches(argv, rd_switches()) {
        Ok(p) => p,
        Err(e) => {
            return Err(switch_error_message(e));
        },
    };
    return Ok(Options(
        help = parsed.help,
        version = parsed.version,
        recurse = has_switch(parsed, "S"),
        quiet = has_switch(parsed, "Q"),
        operands = parsed.operands,
    ));
}
