@mode(host.dual)

# Path helpers shared by the loup-cmd Windows commands (copied from
# ccai-examples/shared/windows; do not edit one repo's copy alone).
#
# Runtime: host.dual. Compiled into each Windows command's native binary by
# `make build`; `loup run source/main.loup` interprets the same code.
#
# The convention, decided once for the whole Windows set:
#
# - Operands accept `\` and `/` as separators (`dir\a.txt`, `dir/a.txt`).
# - Internally every path is kept in "fs form", with `/` only, because that
#   is what io.fs needs on Linux: call fs_path() on an operand before using it.
# - Every path a command prints goes through display_path(), which turns `/`
#   into `\`, the way cmd.exe echoes paths (`sub\a.txt`). This applies to
#   paths the user typed and to paths the command built.
#
# Consequence: a Linux file name that contains a backslash cannot be named
# (Windows file names cannot contain one either).

# The parts of a path: everything before the last separator, and the rest.
pub struct PathParts {
    pub dir: string;
    pub name: string;
}

func is_sep(ch: string): bool {
    return ch == "/" or ch == "\\";
}

# The path in fs form: every `\` becomes `/`.
pub func fs_path(path: string): string {
    return path.replace("\\", "/");
}

# The path as a Windows command prints it: every `/` becomes `\`.
pub func display_path(path: string): string {
    return path.replace("/", "\\");
}

# Whether the path starts at the root (`/x` or `\x`). Drive letters are not
# recognised: there are none on Linux.
pub func is_absolute_path(path: string): bool {
    return path.len() > 0 and is_sep(path.slice(0, 1));
}

# The path without separators at the end; the root stays `/`.
pub func strip_trailing_separators(path: string): string {
    var end = path.len();
    while (end > 1 and is_sep(path.slice(end - 1, end))) {
        end -= 1;
    }
    return fs_path(path.slice(0, end));
}

# Splits a path (either separator) at its last separator, in fs form:
# `sub\*.txt` → (`sub`, `*.txt`), `*.txt` → (``, `*.txt`),
# `/x` → (`/`, `x`), `a//b` → (`a`, `b`), `dir/` → (`dir`, ``).
pub func split_path(path: string): PathParts {
    let p = fs_path(path);
    var i = p.len() - 1;
    while (i >= 0 and p.slice(i, i + 1) != "/") {
        i -= 1;
    }
    if (i < 0) {
        return PathParts(dir = "", name = p);
    }
    var dir = p.slice(0, i);
    while (dir.len() > 0 and dir.slice(dir.len() - 1, dir.len()) == "/") {
        dir = dir.slice(0, dir.len() - 1);
    }
    if (dir.len() == 0) {
        dir = "/";
    }
    return PathParts(dir = dir, name = p.slice(i + 1));
}

# Joins a directory and a name in fs form. An empty directory gives the name
# alone, so `*.txt` expands to `a.txt` rather than `./a.txt`.
pub func join_path(dir: string, name: string): string {
    let d = fs_path(dir);
    if (d.len() == 0) {
        return fs_path(name);
    }
    if (d.slice(d.len() - 1, d.len()) == "/") {
        return d + fs_path(name);
    }
    return d + "/" + fs_path(name);
}

# The last component of a path, ignoring separators at the end.
pub func base_name(path: string): string {
    return split_path(strip_trailing_separators(path)).name;
}

# The directory part of a path in fs form: `` when there is none.
pub func parent_dir(path: string): string {
    return split_path(strip_trailing_separators(path)).dir;
}

# The non-empty components of a path: `a\b//c` → [`a`, `b`, `c`].
pub func path_components(path: string): list[string] {
    var out: list[string] = [];
    for (part in fs_path(path).split("/")) {
        if (part.len() > 0) {
            out.push(part);
        }
    }
    return out;
}
