@mode(host.dual)

# rd (rmdir): removes each directory named on the command line. Without /S the
# directory must be empty; with /S everything in it goes too, after a
# `X, Are you sure (Y/N)?` question unless /Q is given. Symbolic links are
# removed, never followed (see commands/deltree.loup).
#
# Runtime: host.dual. Compiled into the native binary build/rd by
# `make build`; `make run` (Stage0's `loup-bootstrap run`) interprets the same
# code. tests/rd_test.loup runs the deciding functions under Stage0 on
# fixtures in build/tmp/; tests/e2e.sh runs the removals natively in its own
# temporary directory.
#
# Structure: check_operand() and action_for() decide what to do with an
# operand without changing anything; check_operand() throws an RdError, which
# carries Windows' message and the exit status, for one rd cannot remove.
# remove_operand() asks and removes, and returns the lines it could not remove
# with their status (a tuple). Only run_rd() prints: the status of the last
# failure is the exit status.

from appinfo import (EXIT_OK, EXIT_FAILURE, EXIT_FILE_NOT_FOUND, EXIT_PATH_NOT_FOUND,
    EXIT_ACCESS_DENIED, EXIT_IN_USE, EXIT_INVALID_NAME, EXIT_DIR_NOT_EMPTY);
from cli.args import (Options);
from io.fs import (isDir);
from win.messages import (MSG_ACCESS_DENIED, MSG_DIR_NAME_INVALID, MSG_DIR_NOT_EMPTY,
    MSG_FILE_NOT_FOUND, MSG_INVALID_NAME, MSG_PATH_NOT_FOUND, MSG_SYNTAX);
from win.paths import (display_path, fs_path, is_absolute_path, parent_dir, path_components);
from commands.deltree import (sorted_names, entry_present, is_symlink, is_real_dir, unlink_quietly,
    remove_empty_dir, remove_contents, remove_tree);
from commands.prompt import (ask_yes_no, sure_question);

# Windows' message for a directory that is in use: rd cannot remove the
# current directory or one that contains it.
pub const MSG_IN_USE: string = "The process cannot access the file because it is being used by another process.";

# What to do with an operand that check_operand() accepted.
pub const ACT_RMDIR: int = 1;       # an empty directory: remove it
pub const ACT_UNLINK: int = 2;      # a symbolic link to a directory: remove the link only
pub const ACT_TREE: int = 3;        # /S: remove the directory and its contents
pub const ACT_CONTENTS: int = 4;    # /S on the current directory: empty it, then report "in use"

# Characters Windows does not allow in a file or directory name, besides the
# separators `\` and `/` and the control characters. rd does not expand
# wildcards, so `*` and `?` are invalid too.
pub const INVALID_CHARS: string = "<>:\"|?*";

pub func has_invalid_chars(operand: string): bool {
    for (ch in operand) {
        if (INVALID_CHARS.index_of(ch) >= 0) {
            return true;
        }
        let code = match char.fromString(ch) {
            Some(cc) => cc.toInt(),
            None => -1,
        };
        if (code >= 0 and code < 32) {
            return true;
        }
    }
    return false;
}

# The directory an operand names, in fs form: `\` becomes `/`, separators at
# the end go, and `.` and `name\..` are resolved by name, as Windows does
# (`a\..\b` is `b`). Leading `..` of a relative path stay; an empty result
# is `.`, the current directory.
pub func target_path(operand: string): string {
    var parts: list[string] = [];
    for (part in path_components(fs_path(operand))) {
        if (part == ".") {
            continue;
        }
        if (part == ".." and parts.len() > 0 and parts[parts.len() - 1] != "..") {
            parts.pop();
            continue;
        }
        if (part == ".." and is_absolute_path(operand)) {
            continue;
        }
        parts.push(part);
    }
    let joined = parts.join("/");
    if (is_absolute_path(operand)) {
        return "/" + joined;
    }
    if (joined.len() == 0) {
        return ".";
    }
    return joined;
}

# Whether the target (from target_path) is the current directory or one of
# the directories that contain it (`..`, `..\..`).
pub func is_current_or_above(path: string): bool {
    if (path == ".") {
        return true;
    }
    for (part in path_components(path)) {
        if (part != "..") {
            return false;
        }
    }
    return !is_absolute_path(path);
}

# What rd reports for an operand it cannot remove as asked: Windows'
# message and its Win32 error code, which becomes the exit status. Thrown by
# check_operand() and caught by run_rd(), both in this module.
pub class RdError : Exception {
    pub let code: int;

    new(message: string, code: int) {
        super(message);
        this.code = code;
    }
}

# Why the target is not there: the path error when the directory that
# should hold it is missing (or is not a directory), else the file error.
pub func missing_error(path: string): RdError {
    var dir = parent_dir(path);
    if (dir.len() == 0) {
        dir = ".";
    }
    if (!isDir(dir)) {
        return RdError(MSG_PATH_NOT_FOUND, EXIT_PATH_NOT_FOUND);
    }
    return RdError(MSG_FILE_NOT_FOUND, EXIT_FILE_NOT_FOUND);
}

# What rd should do with an operand that check_operand() accepted: one of
# the ACT_ values. Nothing is changed.
pub func action_for(operand: string, recurse: bool): int {
    let path = target_path(operand);
    if (path == ".") {
        return ACT_CONTENTS;
    }
    if (is_symlink(path)) {
        return ACT_UNLINK;
    }
    if (recurse) {
        return ACT_TREE;
    }
    return ACT_RMDIR;
}

# Throws an RdError when rd cannot remove the operand as asked; returns when
# it can. Nothing is changed. With /S, `.` is not a failure yet: its
# contents go first.
pub func check_operand(operand: string, recurse: bool): void {
    if (operand.len() == 0 or has_invalid_chars(operand)) {
        throw RdError(MSG_INVALID_NAME, EXIT_INVALID_NAME);
    }
    let path = target_path(operand);
    if (path == "/") {
        # The root directory is never removed (Windows denies it too).
        throw RdError(MSG_ACCESS_DENIED, EXIT_ACCESS_DENIED);
    }
    if (is_current_or_above(path)) {
        if (path == "." and recurse) {
            return;
        }
        throw RdError(MSG_IN_USE, EXIT_IN_USE);
    }
    if (!entry_present(path)) {
        throw missing_error(path);
    }
    if (!isDir(path)) {
        # A file, or a symbolic link to a file or to nothing. Windows' code
        # for it, 267, does not fit in a Linux exit status.
        throw RdError(MSG_DIR_NAME_INVALID, EXIT_FAILURE);
    }
    if (is_symlink(path)) {
        return;
    }
    if (!is_real_dir(path)) {
        # `test` could not tell what it is: do not touch it.
        throw RdError(MSG_ACCESS_DENIED, EXIT_ACCESS_DENIED);
    }
    if (!recurse and sorted_names(path).len() > 0) {
        throw RdError(MSG_DIR_NOT_EMPTY, EXIT_DIR_NOT_EMPTY);
    }
}

# Removes one operand that check_operand() accepted, with action_for()'s
# action, after the question if `ask` (/S without /Q). Returns the lines to
# print on standard error and the exit status they stand for; an answer of
# N removes nothing and is no error.
pub func remove_operand(operand: string, action: int, ask: bool): (list[string], int) {
    var problems: list[string] = [];
    let path = target_path(operand);
    if (ask and !ask_yes_no(sure_question(display_path(operand)))) {
        return (problems, EXIT_OK);
    }
    if (action == ACT_UNLINK) {
        unlink_quietly(path);
        if (entry_present(path)) {
            problems.push(MSG_ACCESS_DENIED);
        }
    } else if (action == ACT_RMDIR) {
        remove_empty_dir(path);
        if (entry_present(path)) {
            problems.push(MSG_ACCESS_DENIED);
        }
    } else if (action == ACT_CONTENTS) {
        # cmd empties the current directory, then cannot remove it.
        for (line in remove_contents(path)) {
            problems.push(line);
        }
        problems.push(MSG_IN_USE);
        return (problems, EXIT_IN_USE);
    } else {
        problems = remove_tree(path);
    }
    let status = if (problems.len() > 0) { EXIT_ACCESS_DENIED } else { EXIT_OK };
    return (problems, status);
}

pub func run_rd(opts: Options): int {
    if (opts.operands.len() == 0) {
        printErr(MSG_SYNTAX);
        return EXIT_FAILURE;
    }
    let ask = opts.recurse and !opts.quiet;
    var status = EXIT_OK;
    for (op in opts.operands) {
        var accepted = true;
        try {
            check_operand(op, opts.recurse);
        } catch (RdError as e) {
            printErr(e.message);
            status = e.code;
            accepted = false;
        }
        if (accepted) {
            let (lines, code) = remove_operand(op, action_for(op, opts.recurse), ask);
            for (line in lines) {
                printErr(line);
            }
            if (lines.len() > 0) {
                status = code;
            }
        }
    }
    return status;
}
